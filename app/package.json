{
  "name": "gachapuff",
  "private": true,
  "version": "0.1.0",
  "description": "Gachapuff — jeu web de collection de puffs JNR",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "assets": "node scripts/build-assets.ts",
    "icons": "node scripts/build-icons.ts",
    "simulate": "node scripts/simulate.ts",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/pixelify-sans": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  }
}
